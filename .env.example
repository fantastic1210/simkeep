# 访问地址。远程部署时替换为自己的地址，端口需与 SIMKEEP_PORT 一致。
SIMKEEP_PUBLIC_URL=http://localhost:5180
SIMKEEP_SECURE_COOKIES=0
# 本地运行时的数据库路径；Docker Compose 会覆盖为容器内路径。
SIMKEEP_DB=data/simkeep.db
# Docker Compose 公网端口；改端口时同步修改 SIMKEEP_PUBLIC_URL。
SIMKEEP_PORT=5180
# Docker Compose 镜像；使用预构建镜像时改为 ghcr.io/rest-rain/simkeep:latest。
SIMKEEP_IMAGE=simkeep:local

# 可选的公共默认通知服务；用户也可在网页单独配置自己的服务。
# 从 BotFather 获取 Token。可选用户名不包含 @；留空会自动查询。
# 每个 Bot 只运行一个 getUpdates 消费者，不要与其他 Bot 程序共用 Token。
SIMKEEP_TELEGRAM_TOKEN=
SIMKEEP_TELEGRAM_USERNAME=

# SMTP_MODE: starttls (通常 587)、ssl (通常 465)、plain (仅用于受控邮件中继)。
SIMKEEP_SMTP_HOST=
SIMKEEP_SMTP_PORT=587
SIMKEEP_SMTP_MODE=starttls
SIMKEEP_SMTP_USER=
SIMKEEP_SMTP_PASSWORD=
SIMKEEP_SMTP_FROM=
